@model IEnumerable<eStoreASP.Models.Product>

@{
    ViewData["Title"] = "Admin Products";
}

<h2 class="mb-4">Product Management</h2>

<a asp-action="Create"
   class="btn btn-success btn-lg shadow-sm mb-4">
    + Add New Product
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No products available.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th class="text-center">Stock</th>
                        <th>Image</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                @item.Name
                            </td>

                            <td class="text-success">
                                @item.Price.ToString("F2") €
                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td class="text-center">
                                @if (item.Stock == 0)
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                                else if (item.Stock < 5)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Low (@item.Stock)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @item.Stock
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="Product Image"
                                         style="height:50px; border-radius:6px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </td>

                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm me-2 shadow-sm">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');">

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm shadow-sm">
                                        Delete
                                    </button>

                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
}
