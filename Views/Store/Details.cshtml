@model eStoreASP.Models.Product

<h2>@Model.Name</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Price:</strong> @Model.Price.ToString("F2") €</p>
        @if (Model.Stock > 0)
        {
            <a asp-controller="Cart"
               asp-action="Add"
               asp-route-id="@Model.Id"
               class="btn btn-primary btn-lg shadow-sm">
                Add to Cart
            </a>
        }
        else
        {
            <button class="btn btn-secondary btn-lg" disabled>
                Out of Stock
            </button>
        }
        <p><strong>Stock:</strong> @Model.Stock</p>

        <a asp-controller="Store" asp-action="Index" class="btn btn-secondary">
            Back to Store
        </a>
    </div>
</div>
