@model List<eStoreASP.Models.Order>
@using eStoreASP.Models

@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4">My Orders</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have no orders yet.
    </div>
}
else
{
    @foreach (var order in Model)
    {
        var badgeClass = order.Status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Completed => "bg-success",
            _ => "bg-secondary"
        };

        <div class="card mb-4 shadow-sm">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Order #@order.Id</h5>

                    <span class="badge @badgeClass fs-6">
                        @order.Status
                    </span>
                </div>

                <hr />

                <p><strong>Date:</strong> @order.OrderDate.ToString("g")</p>
                <p>
                    <strong>Total:</strong>
                    <span class="text-success fw-bold">
                        @order.TotalAmount.ToString("F2") €
                    </span>
                </p>

                <table class="table table-bordered table-hover align-middle mt-3">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.OrderItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td>
                                    @((item.Price * item.Quantity).ToString("F2")) €
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    }
}
